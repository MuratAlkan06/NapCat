<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>NapCat</string>
	<key>CFBundleIdentifier</key>
	<string>com.muratalkan.napcat</string>
	<key>CFBundleName</key>
	<string>NapCat</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Purpose string shown in the "NapCat wants to control Messages"
	     Automation prompt (Track B / B2 lid-close alert). No entitlement is
	     needed: the Makefile ad-hoc-signs without the hardened runtime. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>NapCat sends you an iMessage when your Mac starts sleeping while a Claude Code task is still running. It only ever messages the address you enter yourself.</string>
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
